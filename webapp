function IconStamp({ filled }) {
  return (
    <div className={`grid h-14 w-14 place-items-center rounded-2xl border-2 ${filled ? "border-orange-500 bg-orange-500 text-white" : "border-slate-200 bg-white text-slate-300"}`}>
