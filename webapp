        <path d="M7 10V6a5 5 0 0 1 10 0v4" />
        <path d="M5 10h14l-1 9H6l-1-9Z" />
        <path d="M8 14h8" />
      </svg>
    </div>
  );
}

function Pill({ children, tone = "slate" }) {
  const tones = {
    slate: "bg-white/80 text-slate-700 ring-slate-200",
    orange: "bg-orange-100 text-orange-700 ring-orange-200",
    blue: "bg-blue-100 text-blue-700 ring-blue-200",
    dark: "bg-slate-950 text-white ring-slate-950",
    green: "bg-emerald-100 text-emerald-700 ring-emerald-200",
  };
  return <span className={`inline-flex items-center rounded-full px-3 py-1 text-xs font-black ring-1 ${tones[tone]}`}>{children}</span>;
}

