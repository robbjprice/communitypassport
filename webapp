  const [sentEmails, setSentEmails] = useState([]);

  const collectedCount = collected.length;
  const progress = Math.round((collectedCount / Math.max(locations.length, 1)) * 100);
  const unlockedRewards = rewards.filter((r) => collectedCount >= r.count);
  const nextReward = rewards.find((r) => collectedCount < r.count);
  const selectedLocation = locations.find((l) => l.id === selectedScan) || locations[0] || businessDirectory[0];
  const alreadyCollected = collected.includes(selectedLocation.id);
  const totalScans = useMemo(() => locations.reduce((sum, l) => sum + (l.scans || 0), 0), [locations]);
  const participants = 184;

  function collectStamp(id) {
    if (!collected.includes(id)) setCollected([...collected, id]);
  }

  function toggleBusiness(business) {
    const exists = locations.some((l) => l.id === business.id);
    if (exists) {
      setLocations(locations.filter((l) => l.id !== business.id));
      setCollected(collected.filter((id) => id !== business.id));
    } else {
      setLocations([...locations, { ...business, scans: 0 }]);
    }
  }

