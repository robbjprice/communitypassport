                    return (
                      <label key={b.id} className={`flex cursor-pointer items-center gap-3 rounded-2xl border p-3 transition ${checked ? "border-orange-300 bg-orange-50" : "border-slate-200 bg-white hover:bg-slate-50"}`}>
                        <input type="checkbox" checked={checked} onChange={() => toggleBusiness(b)} className="h-5 w-5 accent-orange-500" />
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-black text-slate-950">{b.name}</div>
                          <div className="truncate text-xs font-bold text-slate-500">{b.type} · {b.address}</div>
                        </div>
                        <span className={`rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-widest ${checked ? "bg-orange-500 text-white" : "bg-slate-100 text-slate-400"}`}>{checked ? "In" : "Out"}</span>
                      </label>
                    );
                  })}
                </div>
              </section>

              <section className="space-y-6">
                <div className="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-slate-200">
                  <div className="flex flex-wrap items-start justify-between gap-4">
                    <div>
                      <h2 className="text-3xl font-black">Event Map</h2>
                      <p className="mt-1 text-sm font-semibold text-slate-500">Selected businesses appear as numbered pins. In production this would use geocoded addresses and a live map layer.</p>
                    </div>
                    <Pill tone="blue">{locations.length} selected</Pill>
                  </div>
                  <div className="relative mt-5 h-[420px] overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-100">
                    <div className="absolute inset-0 bg-[#efe6d8]">
                      <div className="absolute left-[8%] top-[22%] h-3 w-[90%] -rotate-6 rounded-full bg-white/80 shadow-sm" />
                      <div className="absolute left-[2%] top-[52%] h-3 w-[96%] rotate-2 rounded-full bg-white/80 shadow-sm" />
                      <div className="absolute left-[18%] top-[5%] h-[95%] w-3 rotate-3 rounded-full bg-white/80 shadow-sm" />
                      <div className="absolute left-[58%] top-[0%] h-[100%] w-3 -rotate-2 rounded-full bg-white/80 shadow-sm" />
                      <div className="absolute left-[0%] top-[74%] h-3 w-[100%] -rotate-3 rounded-full bg-white/80 shadow-sm" />
                      <div className="absolute left-[10%] top-[12%] rounded-full bg-orange-100 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-orange-700">Marda Loop</div>
                      <div className="absolute bottom-3 right-3 rounded-full bg-white/90 px-3 py-1 text-[10px] font-black text-slate-500 shadow-sm">Preview map, live map connects in production</div>
                    </div>
                    {locations.map((loc, i) => {
                      const left = `${Math.min(94, Math.max(6, ((loc.lng + 114.126) / 0.028) * 100))}%`;
                      const top = `${Math.min(94, Math.max(6, ((51.029 - loc.lat) / 0.013) * 100))}%`;
                      return <div key={loc.id} className="absolute -translate-x-1/2 -translate-y-full" style={{ left, top }} title={loc.name}><div className="grid h-8 w-8 place-items-center rounded-full bg-orange-500 text-xs font-black text-white shadow-lg ring-4 ring-white">{i + 1}</div></div>;
                    })}
                  </div>
                  <div className="mt-4 grid gap-2 sm:grid-cols-2">
                    {locations.map((loc, i) => <div key={loc.id} className="flex items-center gap-3 rounded-2xl bg-slate-50 p-3"><span className="grid h-7 w-7 place-items-center rounded-full bg-orange-500 text-xs font-black text-white">{i + 1}</span><div className="min-w-0"><div className="truncate text-sm font-black">{loc.name}</div><div className="truncate text-xs font-bold text-slate-500">{loc.address}</div></div></div>)}
                  </div>
                </div>
              </section>
            </div>

            <div className="grid gap-6 xl:grid-cols-[1fr_0.8fr]">
              <section className="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <div className="flex items-start justify-between gap-4">
                  <div>
                    <h2 className="text-3xl font-black">Selected Event Businesses</h2>
                    <p className="mt-1 text-sm font-semibold text-slate-500">These are the QR stamp locations for Social Sundays.</p>
                  </div>
                  <button className="rounded-full bg-slate-950 px-4 py-2 text-sm font-black text-white">Export QR CSV</button>
                </div>
                <div className="mt-6 overflow-hidden rounded-3xl border border-slate-200">
                  <table className="w-full text-left text-sm">
                    <thead className="bg-slate-50 text-xs uppercase tracking-widest text-slate-400"><tr><th className="px-4 py-3">#</th><th className="px-4 py-3">Business</th><th className="px-4 py-3">Type</th><th className="px-4 py-3">QR URL</th><th className="px-4 py-3 text-right">Scans</th></tr></thead>
                    <tbody className="divide-y divide-slate-100">
                      {locations.map((loc, i) => <tr key={loc.id}><td className="px-4 py-4 font-black text-orange-600">{i + 1}</td><td className="px-4 py-4 font-black">{loc.name}<div className="text-xs font-semibold text-slate-400">{loc.address}</div></td><td className="px-4 py-4 font-semibold text-slate-500">{loc.type}</td><td className="px-4 py-4"><code className="rounded-lg bg-slate-100 px-2 py-1 text-xs font-bold text-slate-500">/stamp/{loc.id}</code></td><td className="px-4 py-4 text-right font-black">{loc.scans || 0}</td></tr>)}
                    </tbody>
                  </table>
                </div>
              </section>

              <section className="rounded-[2rem] bg-slate-950 p-6 text-white shadow-xl">
                <h2 className="text-3xl font-black">Contest Email</h2>
                <p className="mt-1 text-sm font-semibold text-white/50">Send updates to everyone taking part in the contest. This preview simulates sending. Production would connect to SendGrid, Mailchimp Transactional, Postmark, or AWS SES.</p>
                <div className="mt-5 rounded-2xl bg-white/10 p-4 text-sm font-bold">Recipients: {participants} contest participants</div>
                <input value={emailSubject} onChange={(e) => setEmailSubject(e.target.value)} className="mt-4 w-full rounded-2xl border-0 bg-white px-4 py-3 text-sm font-bold text-slate-950 outline-none" />
                <textarea value={emailBody} onChange={(e) => setEmailBody(e.target.value)} rows={7} className="mt-3 w-full rounded-2xl border-0 bg-white px-4 py-3 text-sm font-bold text-slate-950 outline-none" />
                <button onClick={() => setSentEmails([{ subject: emailSubject, body: emailBody, time: new Date().toLocaleTimeString(), recipients: participants }, ...sentEmails])} className="mt-3 w-full rounded-2xl bg-orange-500 px-5 py-4 text-sm font-black text-white">Send contest update</button>
                <div className="mt-5 space-y-3">
                  {sentEmails.length === 0 && <div className="rounded-2xl bg-white/10 p-4 text-sm font-semibold text-white/60">No emails sent in this preview yet.</div>}
                  {sentEmails.map((email, i) => <div key={i} className="rounded-2xl bg-white/10 p-4"><div className="text-sm font-black">{email.subject}</div><div className="mt-1 text-xs font-semibold text-white/50">Sent to {email.recipients} people at {email.time}</div></div>)}
                </div>
              </section>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}

export default App;
